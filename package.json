{
  "name": "interface-linux-desktop",
  "version": "0.0.2.6",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run build && node server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server.js",
    "setup:terminal": "npm rebuild node-pty",
    "pack": "npm run build && electron-builder",
    "electron": "electron .",
    "start:electron": "npm run build && electron .",
    "setup:system": "bash setup-environment.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.interface.linuxdesktop",
    "productName": "InterfaceLinux",
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "package.json",
      "electron/**/*",
      "server/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": true
  },
  "description": "Shell/Launcher web para Linux: dispara os apps nativos (Nautilus, GNOME Software, Configurações, Terminal…)",
  "author": "Interface <interface@example.com>"
}
